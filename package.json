{
  "name": "ryuhyo-editor",
  "version": "0.5.0",
  "description": "横書きで書き、縦書きで確かめる小説エディタ",
  "license": "MIT",
  "main": "src/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "electron-builder --win nsis portable"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.5"
  },
  "build": {
    "appId": "jp.ryuhyo.editor",
    "productName": "DRFT",
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/favicon.png",
      "LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-poppler-win32/**/*",
      "node_modules/@tesseract.js-data/**/*"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@tesseract.js-data/jpn": "^1.0.0",
    "@tesseract.js-data/jpn_vert": "^1.0.0",
    "diff": "^8.0.4",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "node-poppler": "^10.0.1",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0",
    "tesseract.js": "^7.0.0"
  },
  "optionalDependencies": {
    "node-poppler-win32": "^1.0.2"
  }
}
