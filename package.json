{
  "name": "ryuhyo-editor",
  "version": "0.5.1",
  "description": "横書きで書き、縦書きで確かめる小説エディタ",
  "license": "MIT",
  "main": "src/main.cjs",
  "type": "module",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "proof:setup": "node scripts/setup-ocr.cjs",
    "ocr:setup": "npm run proof:setup",
    "dist:win": "electron-builder --win nsis portable",
    "build:editor": "node scripts/build-editor.mjs",
    "prestart": "npm run build:editor",
    "predist:win": "npm run build:editor",
    "test:editor": "npm run build:editor && node scripts/verify-editor-browser.mjs",
    "pretest": "npm run build:editor"
  },
  "devDependencies": {
    "electron": "^43.1.0",
    "electron-builder": "^26.0.12",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "playwright": "1.55.1",
    "prettier": "^3.9.5"
  },
  "build": {
    "appId": "jp.ryuhyo.editor",
    "productName": "DRFT",
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/icon.ico",
      "build/favicon.png",
      "LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-poppler-win32/**/*",
      "src/*.py"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "mac": {
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "diff": "^8.0.4",
    "iconv-lite": "^0.7.3",
    "jszip": "^3.10.1",
    "node-poppler": "^10.0.1",
    "pdf-lib": "^1.17.1",
    "pngjs": "^7.0.0"
  },
  "optionalDependencies": {
    "node-poppler-win32": "^1.0.2"
  }
}
